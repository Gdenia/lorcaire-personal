<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:projects="clr-namespace:Lorcaire.Application.Projects.GetProjects;assembly=Lorcaire.Application"
    x:Class="Lorcaire.Desktop.Views.ProjectsView">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="22">
    <Border
        Grid.Row="0"
        Padding="24"
        Background="#0F151B"
        BorderBrush="#252D36"
        BorderThickness="1"
        CornerRadius="10">
      <StackPanel Spacing="14">
        <TextBlock x:Name="FormTitle"
            Text="Create a project"
            Foreground="White"
            FontSize="20"
            FontWeight="SemiBold"/>
        <TextBox
            x:Name="ProjectName"
            PlaceholderText="Project name"
            />
        <TextBox
            x:Name="ProjectDescription"
            PlaceholderText="Description (optional)"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="80"
            />
        <StackPanel Orientation="Horizontal" Spacing="10">
        <Button
            x:Name="CreateProjectButton"
            Content="Create project"
            Click="CreateProject"
            HorizontalAlignment="Left"
            Padding="22,10"
            Background="#E8B04A"
            Foreground="#080C11"/>
        <Button x:Name="SaveProjectButton" Content="Save changes" Click="SaveProject" IsVisible="False" Padding="22,10" Background="#E8B04A" Foreground="#080C11"/>
        <Button x:Name="CancelProjectButton" Content="Cancel" Click="CancelEdit" IsVisible="False" Padding="22,10" Background="#20262D" Foreground="White"/>
        <Button x:Name="ConfirmDeleteButton" Content="Confirm delete" Click="ConfirmDelete" IsVisible="False" Padding="22,10" Background="#A63D49" Foreground="White"/>
        <Button x:Name="CancelDeleteButton" Content="Cancel" Click="CancelDelete" IsVisible="False" Padding="22,10" Background="#20262D" Foreground="White"/>
        </StackPanel>
        <TextBlock
            x:Name="OperationMessage"
            Foreground="#929AA5"
            TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <TextBlock
        Grid.Row="1"
        Text="Your projects"
        Foreground="White"
        FontSize="20"
        FontWeight="SemiBold"/>

    <ScrollViewer Grid.Row="2">
      <ItemsControl x:Name="ProjectsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="projects:ProjectSummary">
            <Border
                Margin="0,0,0,12"
                Padding="20"
                Background="#0F151B"
                BorderBrush="#252D36"
                BorderThickness="1"
                CornerRadius="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="7">
                <TextBlock
                    Text="{Binding Name}"
                    Foreground="White"
                    FontSize="17"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Text="{Binding Description}"
                    Foreground="#929AA5"
                    TextWrapping="Wrap"/>
              </StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Edit" Tag="{Binding Id}" Click="BeginEdit" Padding="14,8" Background="#20262D" Foreground="White"/><Button Content="Delete" Tag="{Binding Id}" Click="DeleteProject" Padding="14,8" Background="#3A2024" Foreground="#F2A0A7"/></StackPanel></Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
