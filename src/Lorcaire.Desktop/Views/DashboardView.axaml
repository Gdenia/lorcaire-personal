<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dashboard="clr-namespace:Lorcaire.Application.Dashboard;assembly=Lorcaire.Application"
    xmlns:views="clr-namespace:Lorcaire.Desktop.Views"
    x:Class="Lorcaire.Desktop.Views.DashboardView">

  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
      <Border Grid.Column="0" Padding="20" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="8">
          <TextBlock Text="Goals" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="GoalCount" Text="0" Foreground="White" FontSize="30"/>
          <TextBlock x:Name="ActiveGoalCount" Text="0 active" Foreground="#8FA9D6"/>
          <Border Height="4" Background="#E8B04A" CornerRadius="2"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Padding="20" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="8">
          <TextBlock Text="Projects" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProjectCount" Text="0" Foreground="White" FontSize="30"/>
          <TextBlock Text="total projects" Foreground="#8FA9D6"/>
          <Border Height="4" Background="#E8B04A" CornerRadius="2"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Padding="20" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="8">
          <TextBlock Text="Tasks" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="PendingTaskCount" Text="0" Foreground="White" FontSize="30"/>
          <TextBlock Text="pending" Foreground="#8FA9D6"/>
          <Border Height="4" Background="#E8B04A" CornerRadius="2"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Padding="20" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="8">
          <TextBlock Text="Resources" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="ResourceCount" Text="0" Foreground="White" FontSize="30"/>
          <TextBlock Text="saved resources" Foreground="#8FA9D6"/>
          <Border Height="4" Background="#E8B04A" CornerRadius="2"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Grid.Column="0" Padding="22" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10" MinHeight="250">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Pending Tasks" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="View tasks →" Click="OpenTasks" Background="Transparent" Foreground="#E8B04A"/>
          </Grid>
          <TextBlock x:Name="TasksEmptyState" Text="No pending tasks. You're all caught up." Foreground="#929AA5"/>
          <ItemsControl x:Name="PendingTasksList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dashboard:DashboardTaskItem">
                <Border Padding="0,10" BorderBrush="#252D36" BorderThickness="0,0,0,1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" Foreground="#929AA5" TextWrapping="Wrap"/>
                    <TextBlock
                        Text="{Binding ProjectName, StringFormat='Project: {0}'}"
                        Foreground="#E8B04A"
                        FontSize="12"
                        IsVisible="{Binding ProjectName, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Padding="22" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10" MinHeight="250">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Upcoming Events" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="View calendar →" Click="OpenCalendar" Background="Transparent" Foreground="#E8B04A"/>
          </Grid>
          <TextBlock x:Name="EventsEmptyState" Text="No upcoming events." Foreground="#929AA5"/>
          <ItemsControl x:Name="UpcomingEventsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:DashboardEventDisplayItem">
                <Border Padding="0,10" BorderBrush="#252D36" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Schedule}" Foreground="#8FA9D6"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Grid.Column="0" Padding="22" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10" MinHeight="210">
        <StackPanel Spacing="14">
          <TextBlock Text="Recent Activity" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="ActivityEmptyState" Text="No recent activity is available yet." Foreground="#929AA5"/>
          <ItemsControl x:Name="RecentActivityList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:DashboardActivityDisplayItem">
                <Grid Margin="0,5" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Description}" Foreground="White"/>
                  <TextBlock Grid.Column="1" Text="{Binding OccurredAtDisplay}" Foreground="#929AA5"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Padding="22" Background="#0F151B" BorderBrush="#252D36" BorderThickness="1" CornerRadius="10" MinHeight="210">
        <StackPanel Spacing="14">
          <TextBlock Text="Quick Actions" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
          <WrapPanel Orientation="Horizontal">
            <Button Content="New goal" Click="OpenGoals" Margin="0,0,10,10" Padding="16,9" Background="#E8B04A" Foreground="#080C11"/>
            <Button Content="New project" Click="OpenProjects" Margin="0,0,10,10" Padding="16,9" Background="#20262D" Foreground="White"/>
            <Button Content="New task" Click="OpenTasks" Margin="0,0,10,10" Padding="16,9" Background="#20262D" Foreground="White"/>
            <Button Content="New event" Click="OpenCalendar" Margin="0,0,10,10" Padding="16,9" Background="#20262D" Foreground="White"/>
            <Button Content="New note" Click="OpenNotes" Margin="0,0,10,10" Padding="16,9" Background="#20262D" Foreground="White"/>
          </WrapPanel>
          <TextBlock x:Name="OperationMessage" Foreground="#D77878" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
