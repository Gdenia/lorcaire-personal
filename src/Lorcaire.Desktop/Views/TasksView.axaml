<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tasks="clr-namespace:Lorcaire.Application.Tasks.GetTasks;assembly=Lorcaire.Application"
    x:Class="Lorcaire.Desktop.Views.TasksView">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="22">
    <Border
        Grid.Row="0"
        Padding="24"
        Background="#0F151B"
        BorderBrush="#252D36"
        BorderThickness="1"
        CornerRadius="10">
      <StackPanel Spacing="14">
        <TextBlock x:Name="FormTitle"
            Text="Create a task"
            Foreground="White"
            FontSize="20"
            FontWeight="SemiBold"/>
        <TextBox
            x:Name="TaskTitle"
            PlaceholderText="Task title"
            MaxLength="200"/>
        <TextBox
            x:Name="TaskDescription"
            PlaceholderText="Description (optional)"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="80"
            MaxLength="1000"/>
        <StackPanel Orientation="Horizontal" Spacing="10"><Button
            x:Name="CreateTaskButton"
            Content="Create task"
            Click="CreateTask"
            HorizontalAlignment="Left"
            Padding="22,10"
            Background="#E8B04A"
            Foreground="#080C11"/><Button x:Name="SaveTaskButton" Content="Save changes" Click="SaveTask" IsVisible="False" Padding="22,10" Background="#E8B04A" Foreground="#080C11"/><Button x:Name="CancelTaskButton" Content="Cancel" Click="CancelEdit" IsVisible="False" Padding="22,10" Background="#20262D" Foreground="White"/><Button x:Name="ConfirmDeleteButton" Content="Confirm delete" Click="ConfirmDelete" IsVisible="False" Padding="22,10" Background="#A63D49" Foreground="White"/><Button x:Name="CancelDeleteButton" Content="Cancel" Click="CancelDelete" IsVisible="False" Padding="22,10" Background="#20262D" Foreground="White"/></StackPanel>
        <TextBlock
            x:Name="OperationMessage"
            Foreground="#929AA5"
            TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <TextBlock
        Grid.Row="1"
        Text="Your tasks"
        Foreground="White"
        FontSize="20"
        FontWeight="SemiBold"/>

    <ScrollViewer Grid.Row="2">
      <ItemsControl x:Name="TasksList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="tasks:TaskSummary">
            <Border
                Margin="0,0,0,12"
                Padding="20"
                Background="#0F151B"
                BorderBrush="#252D36"
                BorderThickness="1"
                CornerRadius="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="7">
                  <TextBlock
                      Text="{Binding Title}"
                      Foreground="White"
                      FontSize="17"
                      FontWeight="SemiBold"/>
                  <TextBlock
                      Text="{Binding Description}"
                      Foreground="#929AA5"
                      TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                    Grid.Column="1"
                    VerticalAlignment="Center">
                  <Button
                      Content="Complete"
                      Tag="{Binding Id}"
                      Click="CompleteTask"
                      IsVisible="{Binding !IsCompleted}"
                      Padding="16,8"
                      Background="#E8B04A"
                      Foreground="#080C11"/>
                  <Button
                      Content="Reopen"
                      Tag="{Binding Id}"
                      Click="ReopenTask"
                      IsVisible="{Binding IsCompleted}"
                      Padding="16,8"
                      Background="#20262D"
                      Foreground="#E8B04A"/>
                  <Button Content="Edit" Tag="{Binding Id}" Click="BeginEdit" Padding="14,8" Background="#20262D" Foreground="White"/>
                  <Button Content="Delete" Tag="{Binding Id}" Click="DeleteTask" Padding="14,8" Background="#3A2024" Foreground="#F2A0A7"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
