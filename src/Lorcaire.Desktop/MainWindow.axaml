<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Lorcaire.Desktop.MainWindow"
    Width="1200"
    Height="760"
    MinWidth="1000"
    MinHeight="650"
    Title="Lorcaire Personal Edition"
    Background="#080C11">

    <Window.Styles>
        <Style Selector="Button.SidebarButton.Selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#171B20"/>
            <Setter Property="Foreground" Value="#E8B04A"/>
        </Style>

        <Style Selector="Button.SidebarButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#171B20"/>
            <Setter Property="Foreground" Value="#E8B04A"/>
        </Style>

        <Style Selector="Button.SidebarButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#20262D"/>
            <Setter Property="Foreground" Value="#E8B04A"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*">

        <!-- SIDEBAR -->
        <Border
            Grid.Column="0"
            Background="#0B1016"
            BorderBrush="#1C232C"
            BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Branding -->
                <StackPanel Margin="24,28,24,36">
                    <TextBlock
                        Text="LORCAIRE"
                        Foreground="#E8B04A"
                        FontSize="22"
                        FontWeight="SemiBold"
                        LetterSpacing="4"/>

                    <TextBlock
                        Text="PERSONAL EDITION"
                        Foreground="#7D8793"
                        FontSize="10"
                        LetterSpacing="2"
                        Margin="1,6,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel
                    Grid.Row="1"
                    Margin="12,0">

                    <Button
                        x:Name="DashboardButton"
                        Classes="SidebarButton"
                        Content="Dashboard"
                        Click="ShowDashboard"
                        Height="46"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"
                        CornerRadius="7"
                        FontSize="15"/>

                    <Button
                        x:Name="GoalsButton"
                        Classes="SidebarButton"
                        Content="Goals"
                        Click="ShowGoals"
                        Height="46"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"
                        FontSize="15"/>

                    <Button
                        x:Name="ProjectsButton"
                        Classes="SidebarButton"
                        Content="Projects"
                        Click="ShowProjects"
                        Height="46"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"
                        FontSize="15"/>

                    <Button
                        x:Name="TasksButton"
                        Classes="SidebarButton"
                        Content="Tasks"
                        Click="ShowTasks"
                        Height="46"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"
                        FontSize="15"/>

                    <Button
                        x:Name="ResourcesButton"
                        Classes="SidebarButton"
                        Content="Resources"
                        Click="ShowResources"
                        Height="46"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"
                        FontSize="15"/>

                    <Button
                        x:Name="CalendarButton"
                        Classes="SidebarButton"
                        Content="Calendar"
                        Click="ShowCalendar"
                        Height="46"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"
                        FontSize="15"/>

                    <Button
                        x:Name="NotesButton"
                        Classes="SidebarButton"
                        Content="Notes"
                        Click="ShowNotes"
                        Height="46"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"
                        FontSize="15"/>

                </StackPanel>

                <!-- Bottom -->
                <StackPanel
                    Grid.Row="2"
                    Margin="12,0,12,22">

                    <Border
                        Height="1"
                        Background="#252C35"
                        Margin="10,0,10,12"/>

                    <Button
                        x:Name="SettingsButton"
                        Classes="SidebarButton"
                        Content="Settings"
                        Click="ShowSettings"
                        Height="42"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"/>

                    <Button
                        x:Name="AboutButton"
                        Classes="SidebarButton"
                        Content="About"
                        Click="ShowAbout"
                        Height="42"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        Background="Transparent"
                        Foreground="#D5D9DE"
                        BorderThickness="0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Column="1">

            <Grid
                Margin="38,28"
                RowDefinitions="Auto,*">

                <!-- Header -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,330"
                    Margin="0,0,0,30">

                    <StackPanel>

                        <TextBlock
                            x:Name="PageTitle"
                            Text="Dashboard"
                            Foreground="White"
                            FontSize="30"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="GreetingText"
                            Text="Good evening, User."
                            Foreground="#E8B04A"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Margin="0,18,0,0"/>

                        <TextBlock
                            Text="Here's what's happening with your life."
                            Foreground="#929AA5"
                            FontSize="14"
                            Margin="0,6,0,0"/>

                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Height="44"
                        Background="#0F141A"
                        BorderBrush="#242C35"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Top">

                        <TextBlock
                            Text="Search anything..."
                            Foreground="#737D88"
                            VerticalAlignment="Center"
                            Margin="16,0"/>

                    </Border>

                </Grid>

                <!-- CONTENIDO DE LA PÁGINA -->
                <ContentControl
                    x:Name="PageContent"
                    Grid.Row="1"/>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>
